{
  "name": "certifier",
  "version": "1.0.0",
  "private": true,
  "description": "Independent, open-source platform for cryptographically verifiable digital credentials",
  "workspaces": [
    "packages/*",
    "workers/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "dev": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=workers/api"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "tsx": "^4.19.2"
  }
}
